<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.diet.mapper.MealSlotTagMapper">
    <delete id="deleteByMealId">
        DELETE FROM meal_slot_tag WHERE meal_id = #{mealId}
    </delete>

    <insert id="insertBatch">
        INSERT INTO meal_slot_tag (meal_id, slot_name, tag_value)
        VALUES
        <foreach collection="tags" item="tag" separator=",">
            (#{tag.mealId}, #{tag.slotName}, #{tag.tagValue})
        </foreach>
    </insert>
</mapper>
